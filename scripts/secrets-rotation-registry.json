{
  "version": 1,
  "defaultRotateEveryDays": 90,
  "warnDaysBefore": 14,
  "secrets": [
    {
      "id": "twenty-app-secret",
      "name": "Twenty CRM APP_SECRET",
      "rotateEveryDays": 365,
      "lastRotated": "2026-07-15",
      "priority": "medium",
      "vpsEnvFiles": [
        "/home/mhgsynccom/mhg-sync-integration/twenty/.env.twenty"
      ],
      "envKeys": [
        "TWENTY_APP_SECRET"
      ],
      "rotateScript": "scripts/setup/27-rotate-twenty-app-secret.sh",
      "manualSteps": [
        "Twenty UI users will need to sign in again after restart"
      ]
    },
    {
      "id": "intake-webhook",
      "name": "Intake webhook secret (FastAPI ↔ Express)",
      "rotateEveryDays": 90,
      "lastRotated": "2026-07-09",
      "priority": "medium",
      "vpsEnvFiles": [
        "/home/mhgsynccom/mhg-sync/.env",
        "/home/mhgsynccom/mhgsync-app/.env"
      ],
      "envKeys": [
        "INTAKE_WEBHOOK_SECRET",
        "SYNC_INTAKE_WEBHOOK_SECRET"
      ],
      "rotateScript": "scripts/setup/26-rotate-intake-webhook-secret.sh"
    },
    {
      "id": "twenty-webhook",
      "name": "Twenty inbound webhook secret",
      "rotateEveryDays": 90,
      "lastRotated": "2026-07-09",
      "priority": "medium",
      "vpsEnvFiles": [
        "/home/mhgsynccom/mhg-sync/.env"
      ],
      "envKeys": [
        "TWENTY_WEBHOOK_SECRET"
      ],
      "rotateScript": "scripts/setup/25-rotate-twenty-webhook-secret.sh",
      "manualSteps": [
        "Twenty UI → Settings → Webhooks → update secret to match .env"
      ]
    },
    {
      "id": "plane-webhook",
      "name": "Plane inbound webhook secret",
      "rotateEveryDays": 90,
      "lastRotated": null,
      "priority": "medium",
      "notes": "Rotate if ever printed in terminal or shared in chat.",
      "vpsEnvFiles": [
        "/home/mhgsynccom/mhg-sync/.env"
      ],
      "envKeys": [
        "PLANE_WEBHOOK_SECRET"
      ],
      "rotateScript": "scripts/setup/18-rotate-plane-webhook-secret.sh",
      "manualSteps": [
        "Plane UI → Workspace → Webhooks → update secret"
      ]
    },
    {
      "id": "twenty-api-key",
      "name": "Twenty outbound API key",
      "rotateEveryDays": 180,
      "lastRotated": null,
      "priority": "low",
      "vpsEnvFiles": [
        "/home/mhgsynccom/mhg-sync/.env"
      ],
      "envKeys": [
        "TWENTY_API_KEY"
      ],
      "manualSteps": [
        "Twenty UI → Settings → API Keys → create new key",
        "Update TWENTY_API_KEY in mhg-sync/.env",
        "pm2 restart api --update-env && pm2 save",
        "Revoke old key in Twenty UI"
      ]
    },
    {
      "id": "redis-password",
      "name": "MHG SYNC Redis password",
      "rotateEveryDays": 365,
      "lastRotated": "2026-07-15",
      "priority": "low",
      "vpsEnvFiles": [
        "/home/mhgsynccom/mhg-sync/.env"
      ],
      "envKeys": [
        "REDIS_PASSWORD"
      ],
      "manualSteps": [
        "Recreate mhg-sync-redis container with new --requirepass",
        "Update REDIS_PASSWORD in .env",
        "pm2 restart api --update-env"
      ]
    },
    {
      "id": "portal-jwt",
      "name": "Client portal JWT secret",
      "rotateEveryDays": 365,
      "lastRotated": null,
      "priority": "low",
      "vpsEnvFiles": [
        "/home/mhgsynccom/mhg-sync/.env"
      ],
      "envKeys": [
        "PORTAL_JWT_SECRET"
      ],
      "manualSteps": [
        "openssl rand -base64 64 → update PORTAL_JWT_SECRET",
        "pm2 restart api --update-env",
        "Existing portal magic links invalidate"
      ]
    }
  ]
}
