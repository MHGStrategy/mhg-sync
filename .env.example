# =============================================================================
# MHG SYNC — Environment Variables
# Copy to .env and fill in values. Never commit .env to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
DOMAIN=sync.mhgstrategy.com
PORT=3000
API_PORT=4000
NEXTAUTH_URL=https://sync.mhgstrategy.com
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Tenant (Tenant Zero)
# -----------------------------------------------------------------------------
TENANT_ID=mhgstrategy
TENANT_SLUG=mhgstrategy

# -----------------------------------------------------------------------------
# Database — PostgreSQL 16 + pgvector
# -----------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=mhgsync_app
POSTGRES_PASSWORD=
POSTGRES_DB_PROD=mhg_sync_prod
POSTGRES_DB_STAGING=mhg_sync_staging
POSTGRES_URL=postgresql://mhgsync_app:PASSWORD@127.0.0.1:5432/mhg_sync_prod

# Legacy FastAPI / discovery dashboards (existing backend/)
DATABASE_URL=sqlite:///../mhgsync.db
API_HOST=0.0.0.0
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://mhgstrategy.com,https://www.mhgstrategy.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
DASHBOARD_BASE_URL=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Redis 7 — internal only (127.0.0.1)
# Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# MinIO — internal only (127.0.0.1)
# Generate credentials: openssl rand -base64 24
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_PROD=mhg-sync-prod
MINIO_BUCKET_STAGING=mhg-sync-staging
MINIO_BUCKET_BACKUPS=mhg-sync-backups

# -----------------------------------------------------------------------------
# LLM — Anthropic (primary) + OpenAI (fallback)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Gmail OAuth (agent email dispatch)
# -----------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Legacy SMTP (existing intake email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@mhgstrategy.com
SMTP_PASS=
SMTP_FROM="MHG Strategy <hello@mhgstrategy.com>"
INTAKE_NOTIFY_EMAIL=shaun@mhgstrategy.com

# -----------------------------------------------------------------------------
# Stripe (Division 2 billing)
# -----------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Intake bridge — forwards discovery dashboard leads to the SYNC CRM
# Set to your Express API intake endpoint (e.g. http://127.0.0.1:4000/api/webhooks/intake for local)
SYNC_INTAKE_WEBHOOK_URL=
SYNC_INTAKE_WEBHOOK_SECRET=
# Express side: shared secret checked on POST /api/webhooks/intake (x-intake-secret header)
INTAKE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Twilio (SMS notifications)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# LinkedIn OAuth (Marketing Agent)
# -----------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Meta / Facebook (Marketing Agent)
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Google Business Profile
# -----------------------------------------------------------------------------
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Backblaze B2 — off-site backups
# -----------------------------------------------------------------------------
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=mhg-sync-backups
B2_ENDPOINT=

# -----------------------------------------------------------------------------
# Client Portal (separate from internal JWT — generate: openssl rand -base64 64)
# -----------------------------------------------------------------------------
PORTAL_JWT_SECRET=
PORTAL_SESSION_MAX_AGE_SECONDS=86400
PORTAL_BASE_URL=https://sync.mhgstrategy.com/portal
CLIENT_PORTAL_BASE_URL=https://sync.mhgstrategy.com/portal
PORTAL_FROM_EMAIL=portal@mhgstrategy.com
PORTAL_MAGIC_LINK_EXPIRY_MINUTES=60

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
ENABLE_SMS=false
ENABLE_LINKEDIN=false
ENABLE_META=false

# -----------------------------------------------------------------------------
# Twenty CRM
# -----------------------------------------------------------------------------
TWENTY_API_URL=https://crm.mhgstrategy.com
TWENTY_API_KEY=
TWENTY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Plane PM
# -----------------------------------------------------------------------------
PLANE_API_URL=https://pm.mhgstrategy.com
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
PLANE_WEBHOOK_SECRET=

# Multi-tenant system database
SYSTEM_DATABASE_URL=postgresql://mhgsync_system:PASSWORD@127.0.0.1:5433/mhgsync_system

# Credential encryption
CREDENTIAL_MASTER_KEY=
# Generate with: tsx scripts/db/generate-master-key.ts

# Tenant provisioning
# Postgres connection with CREATEDB privileges (separate from app user)
POSTGRES_ADMIN_URL=postgresql://mhgsync_admin:PASSWORD@127.0.0.1:5433/postgres
