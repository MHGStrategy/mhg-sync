{
  "name": "mhg-sync",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "npm run dev -w @mhg-sync/api",
    "typecheck": "tsc -b",
    "lint": "eslint \"packages/**/*.ts\" \"apps/api/**/*.ts\"",
    "test": "LLM_MOCK=true node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "seed:crm-demo": "tsx scripts/db/seed-crm-demo.ts",
    "seed:user": "tsx scripts/db/seed-user.ts",
    "seed:prompts": "tsx scripts/db/seed-prompts.ts",
    "verify:sprint3": "bash scripts/local/verify-sprint3.sh",
    "verify:sprint3:live": "LLM_MOCK=false bash scripts/local/verify-sprint3.sh",
    "verify:sprint4": "bash scripts/local/verify-sprint4.sh",
    "build:api": "npm run build -w @mhg-sync/integrations && npm run build -w @mhg-sync/api",
    "start:api": "npm run start -w @mhg-sync/api",
    "dev:api": "npm run build:api && npm run start:api",
    "db:generate": "npm run db:generate -w @mhg-sync/db",
    "db:migrate": "npm run db:migrate -w @mhg-sync/db",
    "db:push": "npm run db:push -w @mhg-sync/db",
    "db:sprint34-migrate": "tsx scripts/db/sprint34-migrate.ts",
    "db:sprint45-migrate": "tsx scripts/db/sprint45-migrate.ts",
    "db:sprint-portal-migrate": "tsx scripts/db/sprint-portal-migrate.ts",
    "db:twenty-plane-migrate": "tsx -r dotenv/config scripts/db/sprint-twenty-plane-migrate.ts",
    "seed:website": "tsx scripts/db/seed-website.ts",
    "verify:sprint45": "bash scripts/local/verify-sprint45.sh",
    "verify:sprint5": "bash scripts/local/verify-sprint5.sh",
    "db:sprint6-migrate": "tsx scripts/db/sprint6-migrate.ts",
    "db:sprint7-migrate": "tsx scripts/db/sprint7-migrate.ts",
    "db:sprint8-migrate": "tsx scripts/db/sprint8-migrate.ts",
    "db:sprint9-migrate": "tsx scripts/db/sprint9-migrate.ts",
    "db:sprint10-migrate": "tsx scripts/db/sprint10-migrate.ts",
