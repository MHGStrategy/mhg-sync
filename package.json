    "db:sprint12-migrate": "tsx scripts/db/sprint12-migrate.ts",
    "db:sprint13-migrate": "tsx scripts/db/sprint13-migrate.ts",
    "db:sprint14-migrate": "tsx scripts/db/sprint14-migrate.ts",
    "db:sprint15-migrate": "tsx scripts/db/sprint15-migrate.ts",
    "db:sprint17-migrate": "tsx scripts/db/sprint17-migrate.ts",
    "db:sprint16-migrate": "tsx scripts/db/sprint16-migrate.ts",
    "db:sprint18-migrate": "tsx scripts/db/sprint18-migrate.ts",
    "seed:it": "tsx scripts/db/seed-it.ts",
    "seed:support-kb": "tsx scripts/db/seed-support-kb.ts",
    "check:stripe": "tsx scripts/setup/check-stripe.ts",
    "verify:sprint6": "bash scripts/local/verify-sprint6.sh",
    "verify:sprint7": "bash scripts/local/verify-sprint7.sh",
    "verify:sprint8": "bash scripts/local/verify-sprint8.sh",
    "verify:sprint9": "bash scripts/local/verify-sprint9.sh",
    "verify:sprint10": "bash scripts/local/verify-sprint10.sh",
    "verify:sprint11": "bash scripts/local/verify-sprint11.sh",
    "verify:sprint12": "bash scripts/local/verify-sprint12.sh",
    "verify:sprint13": "bash scripts/local/verify-sprint13.sh",
    "verify:sprint14": "bash scripts/local/verify-sprint14.sh",
    "verify:sprint15": "bash scripts/local/verify-sprint15.sh",
    "verify:sprint17": "bash scripts/local/verify-sprint17.sh",
    "verify:sprint16": "bash scripts/local/verify-sprint16.sh",
    "verify:sprint18": "bash scripts/local/verify-sprint18.sh",
    "verify:sprint19": "bash scripts/local/verify-sprint19.sh",
    "verify:sprint20": "bash scripts/local/verify-sprint20.sh",
    "verify:sprint21": "bash scripts/local/verify-sprint21.sh",
    "verify:sprint22": "bash scripts/local/verify-sprint22.sh",
    "verify:sprint23": "bash scripts/local/verify-sprint23.sh",
    "verify:sprint24": "bash scripts/local/verify-sprint24.sh",
