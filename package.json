    "verify:sprint26": "bash scripts/local/verify-sprint26.sh",
    "verify:sprint27": "bash scripts/local/verify-sprint27.sh",
    "verify:sprint28": "bash scripts/local/verify-sprint28.sh",
    "verify:sprint29": "bash scripts/local/verify-sprint29.sh",
    "verify:sprint30": "bash scripts/local/verify-sprint30.sh",
    "verify:sprint31": "bash scripts/local/verify-sprint31.sh",
    "db:sprint32-migrate": "tsx scripts/db/sprint32-migrate.ts",
    "verify:sprint32": "bash scripts/local/verify-sprint32.sh",
    "db:sprint33-migrate": "tsx scripts/db/sprint33-migrate.ts",
    "verify:sprint33": "bash scripts/local/verify-sprint33.sh",
    "verify:sprint34": "bash scripts/local/verify-sprint34.sh",
    "verify:deploy-prep": "bash scripts/local/verify-deploy-prep.sh",
    "verify:pyramid-cutover": "bash scripts/local/verify-pyramid-cutover.sh",
    "db:sprint27-migrate": "tsx scripts/db/sprint27-migrate.ts",
    "db:sprint28-migrate": "tsx scripts/db/sprint28-migrate.ts",
    "db:sprint29-migrate": "tsx scripts/db/sprint29-migrate.ts",
    "db:sprint30-migrate": "tsx scripts/db/sprint30-migrate.ts",
    "test:e2e": "cd apps/web && npx playwright test",
    "db:sprint25-migrate": "tsx scripts/db/sprint25-migrate.ts",
    "db:sprint21-migrate": "tsx scripts/db/sprint21-migrate.ts",
    "db:sprint22-migrate": "tsx scripts/db/sprint22-migrate.ts",
    "db:sprint23-migrate": "tsx scripts/db/sprint23-migrate.ts",
    "verify:sprint6:live": "STRIPE_MOCK=false bash scripts/local/verify-sprint6.sh",
    "stack:up": "bash scripts/local/setup.sh",
    "stack:init": "bash scripts/local/init-db.sh",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "stack:reset": "docker compose down -v && npm run stack:up",
    "start:local": "bash scripts/local/start-all.sh",
    "stop:local": "bash scripts/local/stop-api.sh",
    "verify:local": "bash scripts/local/verify.sh",
    "betatest:local": "tsx scripts/betatest/run.ts --phase local",
    "betatest:local:live": "tsx scripts/betatest/run.ts --phase local --live",
    "betatest:deployed": "tsx scripts/betatest/run.ts --phase deployed",
    "betatest:report": "tsx scripts/betatest/generate-report.ts",
    "verify:sprint2": "bash scripts/local/verify-sprint2.sh",
    "preflight:vps": "bash scripts/setup/preflight.sh",
    "secrets-audit": "bash scripts/secrets-audit.sh",
    "secrets-rotation:check": "node scripts/secrets-rotation-check.mjs",
    "secrets-rotation:check:notify": "node scripts/secrets-rotation-check.mjs --notify",
    "secrets-rotation:mark": "node scripts/secrets-rotation-mark.mjs",
    "postinstall": "bash scripts/install-git-hooks.sh 2>/dev/null || true; bash scripts/install-secrets-rotation-reminder.sh 2>/dev/null || true",
    "prepare": "bash scripts/install-git-hooks.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "puppeteer": "^23.11.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
